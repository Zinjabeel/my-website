# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.

# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://launchly.studio

# Contact form delivery via Resend (https://resend.com — free tier is enough).
# 1. Create an account, verify your sending domain, create an API key.
# 2. Paste the key below. Without it, local dev saves submissions to ./.submissions/
#    and production returns a friendly "email us directly" error.
RESEND_API_KEY=
# Where enquiries are delivered (your inbox).
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Launchly <hello@launchly.studio>".
CONTACT_FROM_EMAIL=
