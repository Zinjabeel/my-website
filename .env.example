# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.

# Public URL of the site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://launchly.studio

# ── Accounts, project briefs and contact messages (Supabase) ──────────────────
# 1. Create a project at https://supabase.com (the free plan is enough to start).
# 2. Run supabase/migrations/0001_launchly_accounts.sql in the SQL Editor.
# 3. Project Settings → API: copy the Project URL and the *publishable* key below.
#    Both are safe in the browser — row-level security decides what visitors can do.
# 4. Authentication → URL Configuration: set Site URL to your domain and add
#    https://yourdomain/** (and http://localhost:3000/** for local work) to Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Email copies of contact messages (optional, Resend) ───────────────────────
# With Supabase set, messages are already stored in the `contact_messages` table.
# Add these to also receive each message by email.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
